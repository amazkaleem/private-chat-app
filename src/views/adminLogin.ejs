<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Log In!</title>
</head>
<body>
    <h1>Log In as an Admin!</h1>
    <% if (locals.message) { %>
      <div class="error-alert" style="color: red;">
        <%= message %>
      </div>
    <% } %>
    <form action="/adminLogin/<%= userId %>/patch?_method=PATCH" method="post">
        <label for="adminLoginInput">Please enter the correct passcode!</label>
        <input type="password" placeholder="Type in Admin passcode" name="adminLoginInput" id="adminLoginInput">
        <button type="submit">Log In</button>
    </form>
</body>
</html>